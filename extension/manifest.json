{
  "manifest_version": 3,
  "name": "GPT Web Codex",
  "version": "0.1.0",
  "description": "Use normal ChatGPT Web conversations as the planner for WebGPT Luna.",
  "permissions": ["debugger", "storage", "tabs"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GPT Web Codex",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
